# GitHub GraphQL API — powers every stat on the site
# Classic token, no scopes needed (public data only): https://github.com/settings/tokens/new
GITHUB_TOKEN=

# Upstash Redis — caches computed wraps (6h) so repeat/popular lookups are
# instant and we don't burn GitHub's rate limit. Free tier, no card:
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
